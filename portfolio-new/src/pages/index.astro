---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import About from '../components/About.astro'
import Superpower from '../components/Superpower.astro'
import Experience from '../components/Experience.astro'
import Skills from '../components/Skills.astro'
import Contributions from '../components/Contributions.tsx'
import NowPlaying from '../components/NowPlaying.astro'
import FreeTime from '../components/FreeTime.astro'
import { meta } from '../lib/data'
---

<Layout title="Shobhnik">
  <Hero />

  <div class="divider mb-8"></div>
  <About />

  <Superpower />

  <section class="sr pb-10">
    <Contributions username={meta.githubUsername} client:idle />
  </section>

  <NowPlaying />

  <div class="divider mb-8"></div>
  <Experience />

  <div class="divider mb-8"></div>
  <Skills />

  <div class="divider mb-8"></div>
  <FreeTime />

  <div class="divider mb-8"></div>
</Layout>
