<section id="about" class="sr pb-10 scroll-mt-10">
    <h2 class="lbl">about</h2>

    <div class="space-y-2 text-sm text-fg2 leading-relaxed">
        <p>
            backend & AI engineer with a product mindset. i've owned 0→1
            systems end-to-end at YC and early-stage startups, from
            architecture and APIs to production.
        </p>
        <p>
            i care about systems that hold up at scale, not just code that
            works. most of my code? agents write it. i design the
            architecture, break down hard problems and make sure it doesn't
            suck.
        </p>
        <p>
            i work closely with founders, product and design teams, from
            system design and AI agents to launch and scale.
        </p>
        <p class="pt-1">
            <a href="/projects" class="ul-link text-fg font-medium">
                here are the projects i've built.
            </a>
        </p>

        <!-- Hire me + Resume -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 pt-4">
            <a
                href="https://calendly.com/shobhnikw/whoami"
                target="_blank"
                rel="noopener noreferrer"
                class="hire hire-cta group relative inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap"
                aria-label="hire me, book an intro call"
            >
                <span class="hire-sheen pointer-events-none absolute inset-0 rounded-lg overflow-hidden" aria-hidden="true"></span>

                <span class="hire-tip pointer-events-none absolute bottom-full left-0 mb-2.5 rounded-lg border border-border bg-bg2 px-2.5 py-1.5 text-[11px] font-medium text-fg shadow-xl" aria-hidden="true">
                    a short intro call
                    <span class="hire-tip-arrow absolute top-full left-6"></span>
                </span>

                <span class="hire-roll relative inline-grid" aria-hidden="true">
                    <span class="hire-face"><span class="hire-l" style="--i:0">h</span><span class="hire-l" style="--i:1">i</span><span class="hire-l" style="--i:2">r</span><span class="hire-l" style="--i:3">e</span><span class="hire-l" style="--i:4">&nbsp;</span><span class="hire-l" style="--i:5">m</span><span class="hire-l" style="--i:6">e</span></span>
                    <span class="hire-face hire-face-back"><span class="hire-l" style="--i:0">l</span><span class="hire-l" style="--i:1">e</span><span class="hire-l" style="--i:2">t</span><span class="hire-l" style="--i:3">'</span><span class="hire-l" style="--i:4">s</span><span class="hire-l" style="--i:5">&nbsp;</span><span class="hire-l" style="--i:6">t</span><span class="hire-l" style="--i:7">a</span><span class="hire-l" style="--i:8">l</span><span class="hire-l" style="--i:9">k</span></span>
                </span>

                <span class="relative w-[11px] h-[11px]" aria-hidden="true">
                    <svg class="hire-arrow absolute inset-0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
                    </svg>
                </span>
            </a>
            <button
                type="button"
                data-copy-email="shobhnikw@gmail.com"
                class="inline-flex items-center gap-1.5 text-xs text-fg2 hover:text-fg transition-colors ul-link"
            >
                copy email
            </button>
            <a
                href="https://shobhnik.site/resume"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-fg2 hover:text-fg transition-colors ul-link"
            >
                resume
                <svg
                    width="11"
                    height="11"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
                </svg>
            </a>
            <a
                href="https://shobhnik.site/cover-letter"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-fg2 hover:text-fg transition-colors ul-link"
            >
                cover letter
                <svg
                    width="11"
                    height="11"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    .hire-cta {
        background: linear-gradient(100deg, #7dd3fc, #60a5fa);
        color: #0b0b0b;
        box-shadow: 0 0 0 0 rgb(125 211 252 / 0);
        transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1), box-shadow 0.3s ease;
        animation: hire-breathe 3.2s ease-in-out infinite;
    }
    :global(html:not(.dark)) .hire-cta {
        background: linear-gradient(100deg, #0b1220, #1d4ed8);
        color: #f8fafc;
    }
    :global(html:not(.dark)) .hire-cta:hover {
        box-shadow: 0 0 0 4px rgb(37 99 235 / 0.15), 0 10px 30px -8px rgb(29 78 216 / 0.6);
    }
    :global(html:not(.dark)) .hire-sheen::after {
        background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.25) 50%, transparent 70%);
    }
    .hire-cta:hover {
        animation: none;
        box-shadow: 0 0 0 4px rgb(125 211 252 / 0.2), 0 10px 30px -8px rgb(59 130 246 / 0.65);
    }
    .hire-cta:active {
        transition-duration: 0.1s;
        scale: 0.96;
    }

    .hire-sheen::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.75) 50%, transparent 70%);
        transform: translateX(-120%);
    }
    .hire-cta:hover .hire-sheen::after {
        transition: transform 0.7s ease;
        transform: translateX(120%);
    }

    @keyframes hire-breathe {
        0%, 100% { box-shadow: 0 0 0 0 rgb(125 211 252 / 0); }
        50%      { box-shadow: 0 0 0 5px rgb(125 211 252 / 0.14); }
    }

    :global(.hire-spark) {
        position: fixed;
        z-index: 100;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: #7dd3fc;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .hire-cta { animation: none; transition: box-shadow 0.2s ease; }
        .hire-sheen::after { display: none; }
    }

    .hire-roll {
        overflow: hidden;
        line-height: 1.25;
    }
    .hire-face {
        grid-area: 1 / 1;
        display: inline-flex;
        justify-content: center;
    }
    .hire-l {
        display: inline-block;
        transition: transform 0.45s cubic-bezier(0.6, 0, 0.2, 1);
        transition-delay: calc(var(--i) * 22ms);
    }
    .hire-face-back .hire-l {
        transform: translateY(110%);
    }
    .hire-cta:hover .hire-face:not(.hire-face-back) .hire-l,
    .hire-cta:focus-visible .hire-face:not(.hire-face-back) .hire-l {
        transform: translateY(-110%);
    }
    .hire-cta:hover .hire-face-back .hire-l,
    .hire-cta:focus-visible .hire-face-back .hire-l {
        transform: none;
    }

    .hire-arrow {
        transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
    }
    .hire-cta:hover .hire-arrow {
        transform: rotate(45deg);
    }

    .hire-tip {
        opacity: 0;
        transform: translateY(6px) scale(0.95);
        transform-origin: bottom left;
        transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.3, 1.4, 0.5, 1);
    }
    .hire-cta:hover .hire-tip,
    .hire-cta:focus-visible .hire-tip {
        opacity: 1;
        transform: none;
        transition-delay: 0.15s;
    }
    .hire-tip-arrow {
        width: 8px;
        height: 8px;
        background: hsl(var(--bg2));
        border-right: 1px solid hsl(var(--border));
        border-bottom: 1px solid hsl(var(--border));
        transform: translate(-50%, -50%) rotate(45deg);
    }

    @media (hover: none) {
        .hire-tip { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hire-l, .hire-arrow { transition: none; }
        .hire-tip { transition: opacity 0.15s ease; }
    }
</style>

<script>
    function initHire() {
        const btn = document.querySelector<HTMLElement>('.hire-cta')
        if (!btn || btn.dataset.bound) return
        btn.dataset.bound = '1'

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches

        if (fine && !reduce) {
            btn.addEventListener('mousemove', (e) => {
                const r = btn.getBoundingClientRect()
                const x = (e.clientX - r.left - r.width / 2) * 0.25
                const y = (e.clientY - r.top - r.height / 2) * 0.4
                btn.style.transform = `translate(${x}px, ${y}px)`
            })
            btn.addEventListener('mouseleave', () => (btn.style.transform = ''))
        }

        btn.addEventListener('click', (e) => {
            if (reduce) return
            const r = btn.getBoundingClientRect()
            const cx = e.clientX || r.left + r.width / 2
            const cy = e.clientY || r.top + r.height / 2
            for (let i = 0; i < 12; i++) {
                const s = document.createElement('span')
                s.className = 'hire-spark'
                s.style.background = i % 2 ? '#60a5fa' : '#7dd3fc'
                s.style.left = `${cx - 3}px`
                s.style.top = `${cy - 3}px`
                document.body.appendChild(s)
                const a = (Math.PI * 2 * i) / 12 + Math.random() * 0.4
                const d = 28 + Math.random() * 26
                s.animate(
                    [
                        { transform: 'translate(0, 0) scale(1) rotate(0deg)', opacity: 1 },
                        { transform: `translate(${Math.cos(a) * d}px, ${Math.sin(a) * d}px) scale(0.2) rotate(${120 + Math.random() * 120}deg)`, opacity: 0 },
                    ],
                    { duration: 600 + Math.random() * 200, easing: 'cubic-bezier(0.2, 0.8, 0.3, 1)' },
                ).onfinish = () => s.remove()
            }
        })
    }

    initHire()
    document.addEventListener('astro:page-load', initHire)
</script>
