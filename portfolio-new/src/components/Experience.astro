---
import { experienceData } from '../lib/data'

function initials(company: string) {
  return company.split(' ')[0][0].toUpperCase()
}
---

<section class="sr pb-10">
  <span class="lbl">places i worked at</span>

  <div class="space-y-6">
    {experienceData.map((job) => (
      <div class="flex gap-3">
        <!-- Company avatar -->
        <div class="shrink-0 w-8 h-8 rounded-full bg-bg2 border border-border flex items-center justify-center text-xs font-semibold text-fg2 mt-0.5 overflow-hidden">
          {job.logoUrl
            ? <img
                src={job.logoUrl}
                alt={job.company}
                width="32"
                height="32"
                class="w-5 h-5 object-contain"
                onError="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
            : null}
          {/* Stealth Startup — ghost/lock icon */}
          {!job.logoUrl
            ? <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            : null}
          <span style="display:none" class="w-full h-full flex items-center justify-center">
            {initials(job.company)}
          </span>
        </div>

        <div class="flex-1 min-w-0">
          <!-- Company + date -->
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-medium text-fg leading-snug">{job.company}</p>
            <p class="text-xs text-fg2 whitespace-nowrap shrink-0 font-mono mt-0.5">{job.duration.split('–')[0].trim().toLowerCase()}{' – '}{job.duration.split('–')[1]?.trim().toLowerCase() ?? 'present'}</p>
          </div>

          <!-- Role -->
          <p class="text-xs text-fg2 mt-0.5 mb-2">{job.role.toLowerCase()} · {job.location.split(',')[0].toLowerCase()}</p>

          <!-- Bullets -->
          <ul class="exp-bullets space-y-1 max-h-[2.85rem] overflow-hidden transition-[max-height] duration-300 ease-in-out">
            {job.bullets.map((b) => (
              <li class="text-sm text-fg2 leading-relaxed flex gap-2">
                <span class="text-fg3 shrink-0">-</span>
                <span>
                  {Array.isArray(b)
                    ? b.map((part, i) =>
                        i % 2 === 1
                          ? <span class="text-fg font-medium">{part}</span>
                          : part
                      )
                    : b}
                </span>
              </li>
            ))}
          </ul>

          <button type="button" class="exp-toggle mt-1 text-xs font-mono text-fg2 hover:text-fg transition-colors">
            read more
          </button>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .exp-bullets:not(.expanded) {
    mask-image: linear-gradient(to bottom, black 40%, transparent);
  }
</style>

<script>
  function initExperience() {
    document.querySelectorAll<HTMLElement>('.exp-bullets').forEach((list) => {
      const btn = list.nextElementSibling as HTMLButtonElement | null
      if (!btn || list.dataset.bound) return
      list.dataset.bound = '1'

      if (list.scrollHeight <= list.clientHeight + 1) {
        list.classList.add('expanded')
        btn.remove()
        return
      }

      btn.addEventListener('click', () => {
        const open = list.classList.toggle('expanded')
        list.style.maxHeight = open ? `${list.scrollHeight}px` : ''
        btn.textContent = open ? 'show less' : 'read more'
      })
    })
  }

  initExperience()
  document.addEventListener('astro:page-load', initExperience)
</script>
