---
import { meta } from '../lib/data'
import AskAI from './AskAI.astro'

const birthDate = new Date(2003, 6, 13)
const today = new Date()
let age = today.getFullYear() - birthDate.getFullYear()
if (
  today.getMonth() < birthDate.getMonth() ||
  (today.getMonth() === birthDate.getMonth() && today.getDate() < birthDate.getDate())
) age--
---

<section class="hero relative pt-4 pb-10">
  <div class="hero-bg pointer-events-none absolute -inset-x-5 -top-14 bottom-0 overflow-hidden" aria-hidden="true">
    <span class="hero-blob hero-blob-sky"></span>
    <span class="hero-blob hero-blob-lime"></span>
    <span class="hero-dots"></span>
    <span class="hero-dots hero-dots-lit"></span>
  </div>

  <div class="relative flex items-start justify-between gap-6">
    <!-- Left -->
    <div>
      <h1 class="text-xl font-semibold text-fg tracking-tight mb-1">
        hi, shobhnik here
      </h1>
      <p class="text-fg text-sm">
        {meta.role.toLowerCase()}
      </p>
      <p class="text-fg2 text-sm">
        {age} · he/him · india
      </p>

      {meta.openToCollaborate && (
        <span class="inline-flex items-center mt-2 text-[11px] font-medium text-fg2 border border-border rounded-full px-2.5 py-0.5">
          looking for full-time / contract engineering & product roles
        </span>
      )}

      <!-- Clock + visitors -->
      <div class="flex items-center gap-3 mt-2 flex-wrap">
        <span class="text-xs text-fg3 font-mono flex items-center gap-1.5" id="ist-wrap">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-fg3 opacity-60"></span>
          gurugram, IST&nbsp;<span id="ist-clock" class="tabular-nums">--:--:--</span>
        </span>
        <span id="visitor-wrap" class="text-xs text-fg3 font-mono hidden">
          · <span id="visitor-count"></span> visitors
        </span>
      </div>

      <button
        type="button"
        data-cmdk-open
        class="cmdk-hint hidden sm:inline-flex items-center gap-1.5 mt-3 text-[11px] text-fg3 hover:text-fg2 transition-colors"
      >
        press <kbd class="kbd" id="cmdk-mod">⌘</kbd><kbd class="kbd">K</kbd> to get around
      </button>

      <AskAI />
    </div>

    <!-- Profile image -->
    <img
      src="/IntroImg.jpeg"
      alt="shobhnik"
      class="w-14 h-14 rounded-full object-cover shrink-0 grayscale opacity-90 transition-[filter,opacity,transform] duration-500 ease-out hover:grayscale-0 hover:opacity-100 hover:scale-105"
    />
  </div>
</section>

<style>
  .hero-bg {
    --mx: 70%;
    --my: 30%;
    mask-image: radial-gradient(ellipse 50% 100% at 50% 0%, black 40%, transparent 100%);
  }

  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(hsl(var(--fg) / 0.13) 1px, transparent 1.2px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse 70% 80% at 70% 20%, black, transparent 75%);
  }
  .hero-dots-lit {
    background-image: radial-gradient(hsl(var(--fg) / 0.55) 1px, transparent 1.4px);
    mask-image: radial-gradient(140px circle at var(--mx) var(--my), black, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero:hover .hero-dots-lit {
    opacity: 1;
  }

  .hero-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(60px);
  }
  .hero-blob-sky {
    width: 320px;
    height: 220px;
    top: -60px;
    right: -40px;
    background: #38bdf8;
    opacity: 0.18;
    animation: hero-drift 16s ease-in-out infinite;
  }
  .hero-blob-lime {
    width: 220px;
    height: 160px;
    top: 40px;
    right: 180px;
    background: #3b82f6;
    opacity: 0.1;
    animation: hero-drift 20s ease-in-out infinite reverse;
  }
  :global(html:not(.dark)) .hero-blob { display: none; }
  :global(html:not(.dark)) .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 70% at 12% 0%, rgb(30 64 175 / 0.16), transparent 70%),
      radial-gradient(34% 65% at 45% 8%, rgb(37 99 235 / 0.15), transparent 70%),
      radial-gradient(38% 75% at 82% 0%, rgb(29 78 216 / 0.2), transparent 70%),
      radial-gradient(60% 50% at 60% -10%, rgb(14 165 233 / 0.1), transparent 75%);
    animation: hero-wash 18s ease-in-out infinite alternate;
  }
  @keyframes hero-wash {
    to { transform: translateX(-3%) scale(1.04); }
  }

  @keyframes hero-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(-40px, 25px) scale(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-blob, .hero-bg::before { animation: none; }
  }
</style>

<script>
  function initClock() {
    const clockEl = document.getElementById('ist-clock')
    if (!clockEl) return

    function updateClock() {
      const ist = new Date(Date.now() + (5 * 60 + 30) * 60 * 1000)
      const h = String(ist.getUTCHours()).padStart(2, '0')
      const m = String(ist.getUTCMinutes()).padStart(2, '0')
      const s = String(ist.getUTCSeconds()).padStart(2, '0')
      clockEl.textContent = `${h}:${m}:${s}`
    }

    updateClock()
    // clear any interval left from a previous visit to this page
    clearInterval((window as any).__clockInterval)
    ;(window as any).__clockInterval = setInterval(updateClock, 1000)
  }

  // ── Visitor counter (runs once per session) ────────────────
  function initVisitor() {
    const wrap  = document.getElementById('visitor-wrap')
    const count = document.getElementById('visitor-count')
    if (!wrap || !count || (window as any).__visitorFetched) return
    ;(window as any).__visitorFetched = true

    fetch('https://api.counterapi.dev/v1/shobhnik-portfolio/visits/up')
      .then((r) => r.json())
      .then((d) => {
        if (d?.count) {
          count.textContent = Number(d.count).toLocaleString()
          wrap.classList.remove('hidden')
        }
      })
      .catch(() => {})
  }

  function initHint() {
    const mod = document.getElementById('cmdk-mod')
    if (mod && !/Mac|iPhone|iPad/.test(navigator.platform)) mod.textContent = 'ctrl'
  }

  function initSpotlight() {
    const hero = document.querySelector<HTMLElement>('.hero')
    const bg = hero?.querySelector<HTMLElement>('.hero-bg')
    if (!hero || !bg || hero.dataset.bound) return
    hero.dataset.bound = '1'
    hero.addEventListener('mousemove', (e) => {
      const r = bg.getBoundingClientRect()
      bg.style.setProperty('--mx', `${e.clientX - r.left}px`)
      bg.style.setProperty('--my', `${e.clientY - r.top}px`)
    })
  }

  initClock()
  initVisitor()
  initHint()
  initSpotlight()
  // re-init clock on every navigation back to home
  document.addEventListener('astro:page-load', () => { initClock(); initVisitor(); initHint(); initSpotlight() })
</script>
