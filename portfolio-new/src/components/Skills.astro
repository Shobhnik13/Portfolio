---
import { skillData } from '../lib/data'
---

<section class="sr pb-10">
  <h2 class="lbl">skills / tools</h2>

  <div class="space-y-2.5">
    {skillData.map((cat) => (
      <div class="grid grid-cols-1 sm:grid-cols-[8.5rem_1fr] gap-x-3 gap-y-1">
        <p class="text-[10px] uppercase tracking-widest text-fg3 font-medium sm:pt-[3px]">{cat.category}</p>
        <p class="text-xs text-fg2 leading-relaxed">
          {cat.skills.map((skill, j) => (
            <>
              <span class="skill">{skill}</span>
              {j < cat.skills.length - 1 && <span class="text-fg3"> · </span>}
            </>
          ))}
        </p>
      </div>
    ))}
  </div>

  <p class="eta-line mt-5 text-[11px] font-mono text-fg3">
    skill you need not listed? nevermind, i'll figure it out in
    <span class="eta relative inline-flex">
      <span class="eta-old">4–5</span>
      <span class="eta-new" aria-hidden="true">2</span>
    </span>
    business days :)
  </p>
</section>

<style>
  .skill {
    transition: color 0.15s ease;
  }
  .skill:hover {
    color: hsl(var(--fg));
  }

  .eta-line {
    cursor: default;
  }
  .eta {
    transition: margin-right 0.25s ease;
  }
  .eta-old {
    background: linear-gradient(currentColor, currentColor) 0 55% / 0% 1px no-repeat;
    transition: background-size 0.3s ease, color 0.3s ease;
  }
  .eta-new {
    position: absolute;
    left: 100%;
    margin-left: 0.35em;
    color: hsl(var(--fg));
    opacity: 0;
    transform: translateY(-6px) rotate(-8deg);
    transition: opacity 0.25s ease 0.2s, transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) 0.2s;
  }
  .eta-line:hover .eta-old {
    background-size: 100% 1px;
  }
  .eta-line:hover .eta {
    margin-right: 1.1em;
  }
  .eta-line:hover .eta-new {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .eta, .eta-old, .eta-new { transition: none; }
  }
</style>
