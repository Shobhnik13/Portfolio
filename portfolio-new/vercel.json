{
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/resume",
      "destination": "https://resume.shobhnik.site/resume/software-resume.pdf"
    },
    {
      "source": "/resume.pdf",
      "destination": "https://resume.shobhnik.site/resume/software-resume.pdf"
    },
    {
      "source": "/cover-letter",
      "destination": "https://resume.shobhnik.site/cover-letter/software-cover-letter.pdf"
    },
    {
      "source": "/cover-letter.pdf",
      "destination": "https://resume.shobhnik.site/cover-letter/software-cover-letter.pdf"
    }
  ]
}
