{
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/resume.pdf",
      "destination": "https://resume.shobhnik.site/resume.pdf"
    }
  ],
  "redirects": [
    {
      "source": "/cover-letter",
      "destination": "https://drive.google.com/file/d/1vQ_1nbgzUYIv2t9vxVFL7qbVIL2F0lJH/view?usp=sharing",
      "permanent": false
    }
  ]
}
